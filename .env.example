SHOPIFY_STORE_URL=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
ANTHROPIC_API_KEY=sk-ant-...
# CJDropshipping API key — developers.cjdropshipping.com → My CJ → API
